# Copy this file to .env and fill in your keys.

# ── LLM Provider — pick ONE and fill in its key ──────────────────────────────
# Options: anthropic | gemini | deepseek | groq | openai
LLM_PROVIDER=gemini

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini — free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# DeepSeek — free tier at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Groq — free tier at https://console.groq.com
GROQ_API_KEY=

# OpenAI — paid only, https://platform.openai.com
OPENAI_API_KEY=

# ── Models (defaults per provider — override if you want) ─────────────────────
# anthropic  → claude-haiku-4-5-20251001  (cheapest Claude)
# gemini     → gemini-2.0-flash           (free tier)
# deepseek   → deepseek-chat              (free tier)
# groq       → llama-3.3-70b-versatile    (free tier)
# openai     → gpt-4o-mini                (cheapest GPT)
CHAT_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── RAG / Vector DB ───────────────────────────────────────────────────────────
# "chroma" (dev, file-based) | "faiss" (dev, in-memory) | "qdrant" (prod)
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=storage/chroma
KB_DIR=../../knowledge-base

# ── Language (Bhashini or fallback deep-translator) ───────────────────────────
BHASHINI_API_KEY=
# Supported language codes: en, hi, bn, te, mr, ta, gu, kn, pa, ur
DEFAULT_LANGUAGE=en

# ── Infra ─────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./legalbot.db
UPLOAD_DIR=storage
CORS_ORIGINS=http://localhost:5173

# ── Document generation ────────────────────────────────────────────────────────
TEMPLATES_DIR=app/templates
OUTPUT_DIR=storage/docs
