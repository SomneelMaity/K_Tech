# Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API Configuration
API_TITLE="LegalBot API"
API_VERSION=1.0.0
API_PREFIX=/api/v1

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (PostgreSQL - Optional)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legalbot
# For async: postgresql+asyncpg://postgres:postgres@localhost:5432/legalbot

# Redis (Caching & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
LLM_PROVIDER=openai  # openai, anthropic, local
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768

# Vector Database
VECTOR_DB_TYPE=faiss  # faiss, chroma
VECTOR_DB_PATH=./vector_store
FAISS_INDEX_TYPE=IVFFlat
CHROMA_PERSIST_DIR=./chroma_db

# RAG Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_RERANK=True
RAG_HYBRID_SEARCH=True

# Language & Translation
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,bn,te,mr,ta,gu,kn,ml,or,pa

# Speech (Bhashini or Web Speech API)
SPEECH_PROVIDER=bhashini  # bhashini, google, whisper
WHISPER_MODEL=base  # tiny, base, small, medium, large
TTS_PROVIDER=bhashini

# Document Generation
DOC_GEN_FORMAT=pdf,docx
TEMPLATE_DIR=./app/templates
OUTPUT_DIR=./generated_docs
MAX_DOC_SIZE_MB=5

# Safety & Moderation
ENABLE_SAFETY_MIDDLEWARE=True
EMERGENCY_DETECTION=True
CONTENT_MODERATION=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=200

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=True

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=True

# WhatsApp Business API (Optional)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Analytics (Optional)
ENABLE_ANALYTICS=True
ANALYTICS_DB=legalbot_analytics

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,docx

# Session
SESSION_TIMEOUT_MINUTES=60
SESSION_CLEANUP_HOURS=24
