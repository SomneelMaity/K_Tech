# Copy this file to .env and fill in your keys.

# Anthropic (copy generation)
ANTHROPIC_API_KEY=

# Image generation. Default provider is Pollinations (free, no key needed).
# The keys below are OPTIONAL paid upgrades:
#   Gemini image gen requires BILLING (free tier does not include images).
GEMINI_API_KEY=
#   Replicate (Flux, ~$0.003/image) — https://replicate.com/account
REPLICATE_API_TOKEN=

# Models (sensible defaults — override if you want)
COPY_MODEL=claude-opus-4-8
STRATEGY_MODEL=claude-haiku-4-5-20251001
IMAGE_MODEL=black-forest-labs/flux-schnell
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Image backend: pollinations (free) | gemini | replicate | placeholder | auto
IMAGE_PROVIDER=pollinations

# Image generation resilience
IMAGE_TIMEOUT=180
IMAGE_RETRIES=2

# Infra
DATABASE_URL=sqlite:///./ugc.db
UPLOAD_DIR=storage
CORS_ORIGINS=http://localhost:5173
# Required for Instagram publishing because Meta must fetch the image from a
# public URL. Use your deployed backend URL or an HTTPS tunnel like ngrok.
PUBLIC_BASE_URL=

# X publishing. Requires OAuth2 user token with tweet.write and media.write.
X_ACCESS_TOKEN=
X_API_BASE=https://api.x.com/2

# Instagram / Meta Graph API publishing and ads.
# Latest Graph API version as of July 2026 is v25.0.
META_GRAPH_VERSION=v25.0
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
