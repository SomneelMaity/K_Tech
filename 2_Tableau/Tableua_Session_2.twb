      <aliases enabled='yes' />
      <column caption='2023 Sales' datatype='real' name='[2024 Sales (copy)_35849357947670538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = YEAR(TODAY()) - 3 THEN [Sales] END' />
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / TOTAL(SUM([Sales]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / TOTAL(SUM([Sales]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='UPPER' datatype='string' name='[Calculation_25213781532680192]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([Region])' />
      </column>
      <column caption='LOWER' datatype='string' name='[Calculation_25213781533802497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LOWER([Region])' />
      </column>
      <column caption='PROPER' datatype='string' name='[Calculation_25213781533876226]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='PROPER([Region])' />
      </column>
      <column caption='FIrst 4 Digits' datatype='string' name='[Calculation_25213781534597123]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([Order ID],4)' />
      </column>
      <column caption='Last 3 Digits' datatype='string' name='[Calculation_25213781535043588]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='RIGHT([Order ID],3)' />
      </column>
      <column caption='Mid Digit' datatype='string' name='[Calculation_25213781535584261]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MID([Order ID],4,4)' />
      </column>
      <column caption='Combining' datatype='string' name='[Calculation_35849357838897152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Order ID - Split 1]+&apos; &apos;+[Order ID - Split 2]+&apos; &apos;+[Order ID - Split 3]' />
      </column>
      <column caption='Combine Category + SubCategory' datatype='string' name='[Calculation_35849357841268738]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Category]+&apos; - &apos;+[Sub-Category]' />
      </column>
      <column caption='If Functio  Subcategory' datatype='string' name='[Calculation_35849357842653187]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales]) &lt;= 95000 THEN &apos;Low Sales&apos;&#13;&#10;ELSEIF SUM([Sales]) &lt;= 200000 THEN &apos;Mid Sales&apos;&#13;&#10;ELSEIF SUM([Sales]) &gt; 200000 THEN &apos;High Sales&apos; END' />
      </column>
      <column caption='RANK' datatype='integer' name='[Calculation_35849357846069252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Sales]),&apos;asc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='datename' datatype='string' name='[Calculation_35849357936300037]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[Order Date])' />
      </column>
      <column caption='Jan,Sept' datatype='boolean' name='[Calculation_35849357939240967]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_35849357936300037] in (&apos;January&apos;,&apos;September&apos;)' />
      </column>
      <column caption='datetrunc' datatype='datetime' name='[Calculation_35849357943910408]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[Order Date]) - 1' />
      </column>
      <column caption='2024 Sales' datatype='real' name='[Calculation_35849357946085385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = YEAR(TODAY()) - 2 THEN [Sales] END' />
      </column>
      <column caption='Percentage Change' datatype='real' default-format='p0.000%' name='[Calculation_35849357947850763]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_35849357946085385] - [2024 Sales (copy)_35849357947670538]) / [2024 Sales (copy)_35849357947670538]' />
      </column>
      <column caption='NOW' datatype='datetime' name='[Calculation_35849357951873036]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='NOW()' />
      </column>
      <column caption='TODAY' datatype='date' name='[Calculation_35849357953933325]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='TODAY()' />
      </column>
      <column caption='TOP and BOTTOM 2 Values' datatype='string' name='[Calculation_35849357954908174]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK(SUM([Sales]),&apos;desc&apos;)&lt;=2 THEN &apos;Top 2 Subcategory&apos;&#13;&#10;&#13;&#10;ELSEIF RANK(SUM([Sales]),&apos;asc&apos;)&lt;=2 THEN &apos;Bottom 2 Subcategory&apos; &#13;&#10;&#13;&#10;ELSE &apos;Remaining&apos;  END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Below and Above Avg Sales' datatype='string' name='[Calculation_35849357958008847]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales])&gt;WINDOW_AVG(SUM([Sales])) THEN &apos;Above AVG Sales&apos;&#13;&#10;ELSEIF SUM([Sales])&lt;=WINDOW_AVG(SUM([Sales])) THEN &apos;Below AVG Sales&apos;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank of Sales' datatype='integer' name='[Calculation_35849357965676560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Percentage' datatype='real' default-format='p0.00%' name='[Calculation_35849358109700121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / MAX({SUM([Sales])})' />
      </column>
      <column caption='Select Measure Calculated' datatype='real' name='[Calculation_35849358114377754]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN 1 THEN [Sales]&#13;&#10;WHEN 2 THEN [Profit]&#13;&#10;WHEN 3 THEN [Quantity]&#13;&#10;WHEN 4 THEN [Discount]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Dimensions' datatype='string' name='[Calculation_35849358117384219]' role='dimension' type='nominal'>
