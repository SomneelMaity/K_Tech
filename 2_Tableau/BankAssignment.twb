      <column datatype='date' datatype-customized='true' name='[Bank DOJ]' role='dimension' type='ordinal' />
      <column aggregation='Sum' caption='Year' datatype='integer' name='[Calculation_2004202253774850]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([Bank DOJ])' />
      </column>
      <column caption='Month Name' datatype='string' name='[Calculation_2004202253910019]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [Bank DOJ])' />
      </column>
      <column caption='Month Number' datatype='integer' name='[Calculation_2004202254278660]' role='measure' type='quantitative'>
