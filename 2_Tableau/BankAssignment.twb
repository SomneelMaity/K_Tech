      <column caption='Credit Type' datatype='string' name='[Calculation_2004202533179400]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CreditScore] &gt;= 750 THEN &quot;Excellent&quot;&#13;&#10;ELSEIF [CreditScore] &gt;= 700 THEN &quot;Very Good&quot;&#13;&#10;ELSEIF [CreditScore] &gt;= 650 THEN &quot;Good&quot;&#13;&#10;ELSEIF [CreditScore] &gt;= 600 THEN &quot;Fair&quot;&#13;&#10;ELSE &quot;Poor&quot;&#13;&#10;END' />
